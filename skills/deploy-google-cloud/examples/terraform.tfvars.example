# Example terraform.tfvars configuration for deploying electric-sheep to Google Cloud
# Copy this file to terraform.tfvars and customize for your environment.
# Note: Always run `terraform fmt` and `terraform validate` after editing Terraform files.

project_id          = "your-gcp-project-id"
region              = "us-central1"
model_name          = "gemini-3.5-flash-lite"

bq_dataset_id       = "adk_agent_telemetry"
bq_table_id         = "agent_logs"

spanner_instance_id = "adk-spanner-instance"
spanner_database_id = "agent_memory_db"

otel_to_cloud       = true

# Optional container override (defaults to Python slim test image if not set)
# container_image     = "us-docker.pkg.dev/cloudrun/container/hello"

# Frontend Control Center Auth Config
allowed_email_domains        = "example.com,user@example.com"
firebase_api_key             = "your_firebase_api_key_here"
firebase_auth_domain         = "your-project-id.firebaseapp.com"
firebase_project_id          = "your-project-id"
firebase_storage_bucket      = "your-project-id.firebasestorage.app"
firebase_messaging_sender_id = "123456789012"
firebase_app_id              = "1:123456789012:web:your_app_id_here"

# Optional Identity-Aware Proxy (IAP) & Reverse Proxy Configuration
# iap_enabled           = true
# iap_expected_audience = "/projects/123456789012/global/backendServices/your-backend-service-id"
# iap_header_name       = "x-goog-iap-jwt-assertion"
# iap_proxy_url         = "https://app.example.com"

# Optional list of additional IAM members authorized to invoke backend Cloud Run services
# authorized_invoker_members = ["user:developer@example.com"]
