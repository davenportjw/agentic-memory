# Google ADK 2.0 Multi-Agent Demo Environment Variables
# Copy this file to .env and adjust values for your Google Cloud environment

# --- Google Cloud Core Project & Region ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_LOCATION=global

# --- AI Model Selection (Default: gemini-3.5-flash-lite) ---
MODEL_NAME=gemini-3.5-flash-lite

# --- Google Cloud Spanner Configuration ---
SPANNER_INSTANCE_ID=adk-spanner-instance
SPANNER_DATABASE_ID=agent_memory_db

# --- Google Cloud BigQuery Telemetry Configuration ---
BQ_DATASET_ID=adk_agent_telemetry
BQ_TABLE_ID=agent_logs

# --- OpenTelemetry & Observability Flags ---
OTEL_TO_CLOUD=false
ENABLE_TELEMETRY=true
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true

# --- Offline / Demo Mode (Set to false when deploying to live GCP infrastructure) ---
USE_MOCK_CLIENTS=true

# --- UI Service API Configuration ---
PORT=8080
INTERVIEW_AGENT_URL=http://localhost:8081
PREFERENCE_AGENT_URL=http://localhost:8082

# --- Authentication & Firebase Web SDK Configuration ---
ALLOWED_EMAIL_DOMAINS=example.com,user@example.com
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:your_app_id_here

# --- Identity-Aware Proxy (IAP) & Reverse Proxy Configuration ---
IAP_ENABLED=false
IAP_EXPECTED_AUDIENCE=/projects/YOUR_PROJECT_NUMBER/global/backendServices/YOUR_BACKEND_SERVICE_ID
IAP_HEADER_NAME=x-goog-iap-jwt-assertion
IAP_PROXY_URL=
